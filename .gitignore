# The trained demo model and its metadata are committed so the deployed app can predict.
# Rebuild them with `python -m src.save_model`. (joblib files can execute code when
# loaded, so only load model files from sources you trust.)
models/*
!models/.gitkeep
!models/student_performance_model.joblib
!models/model_metadata.json

